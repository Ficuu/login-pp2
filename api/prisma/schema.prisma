// Esquema del padron de PP2. Espeja database/init.sql del servicio original
// (FastAPI + mysql-connector), tabla por tabla, sin renombrar columnas: lo que
// consumen los otros proyectos es el contrato HTTP, no este esquema, pero
// mantenerlo igual evita traducir dos veces la misma logica.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Usuario {
  id       Int    @id @default(autoincrement())
  nombre   String @db.VarChar(50)
  apellido String @db.VarChar(50)
  email    String @unique @db.VarChar(100)
  // Hash bcrypt (60 caracteres). VARCHAR(255) por margen, no porque la
  // contraseña pueda ser tan larga: bcrypt no mira mas alla de 72 bytes.
  password String @db.VarChar(255)

  proyectos       UsuarioProyecto[]
  codigosLogin    CodigoLogin[]
  resetsPassword  ResetPassword[]

  @@map("usuarios")
}

model Proyecto {
  id     Int     @id @default(autoincrement())
  nombre String  @db.VarChar(100)
  // Donde vive el front de ese proyecto: a donde vuelve la persona cuando
  // entra. Sale de aca y nunca del pedido (POST /codigos): si el que pide el
  // codigo pudiera elegir el destino, mandaria el codigo de otra persona a un
  // sitio propio.
  url    String? @db.VarChar(255)

  usuarios     UsuarioProyecto[]
  aplicaciones Aplicacion[]
  codigosLogin CodigoLogin[]

  @@map("proyectos")
}

model UsuarioProyecto {
  usuarioId  Int @map("usuario_id")
  proyectoId Int @map("proyecto_id")

  usuario  Usuario  @relation(fields: [usuarioId], references: [id])
  proyecto Proyecto @relation(fields: [proyectoId], references: [id])

  @@id([usuarioId, proyectoId])
  @@map("usuario_proyecto")
}

// Aplicaciones que le pegan a esta API: el login central y el front de cada
// proyecto. Cada una tiene su token, para que la API sepa quien pregunta y le
// devuelva solo lo suyo (ver GET /usuarios).
//
// proyectoId NULL = ve el padron entero: es el login central, que ofrece
// "elegi tu proyecto" antes de saber a cual va la persona. Esa fila la
// sincroniza el servicio al arrancar desde API_TOKEN, no se crea a mano.
model Aplicacion {
  id         Int       @id @default(autoincrement())
  nombre     String    @unique @db.VarChar(100)
  proyectoId Int?      @map("proyecto_id")
  // Hash SHA-256 del token, no el token: con un dump de la base no se entra a
  // ningun lado. Se genera con 256 bits de azar, por eso no hace falta bcrypt.
  tokenHash  String    @unique @map("token_hash") @db.Char(64)
  creadaEn   DateTime  @default(now()) @map("creada_en")
  revocadaEn DateTime? @map("revocada_en")

  proyecto Proyecto? @relation(fields: [proyectoId], references: [id])

  @@map("aplicaciones")
}

// Codigos de ingreso a un proyecto (POST /codigos). Un solo uso y unos
// segundos de vida: solo tienen que sobrevivir el redirect del login al
// proyecto.
model CodigoLogin {
  id         Int       @id @default(autoincrement())
  usuarioId  Int       @map("usuario_id")
  proyectoId Int       @map("proyecto_id")
  codigoHash String    @unique @map("codigo_hash") @db.Char(64)
  venceEn    DateTime  @map("vence_en")
  usadoEn    DateTime? @map("usado_en")

  usuario  Usuario  @relation(fields: [usuarioId], references: [id])
  proyecto Proyecto @relation(fields: [proyectoId], references: [id])

  @@map("codigos_login")
}

// Tokens de reset de contraseña (POST /password/reset). Mismo motivo que los
// de aplicaciones: se guarda el hash, no el token.
model ResetPassword {
  id         Int       @id @default(autoincrement())
  usuarioId  Int       @map("usuario_id")
  tokenHash  String    @unique @map("token_hash") @db.Char(64)
  venceEn    DateTime  @map("vence_en")
  usadoEn    DateTime? @map("usado_en")

  usuario Usuario @relation(fields: [usuarioId], references: [id])

  @@map("resets_password")
}
