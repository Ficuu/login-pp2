# URL base del registro central de PP2 (https://github.com/Ficuu/register-pp2)
REGISTRO_URL="http://localhost:3000/api/registro"

# API key de ESTA aplicacion. La imprime una sola vez el comando
#   npm run registro:app -- "Login PP2" --responsable="Facu"
# dentro del repo del registro.
#
# NUNCA la expongas al navegador: no la prefijes con NEXT_PUBLIC_ ni la
# uses desde un componente cliente. Identifica al proyecto entero.
REGISTRO_API_KEY="pp2_..."
