# Copia este archivo a `.env` y cambia los valores. El `.env` NO se sube al
# repositorio: es el unico lugar donde vive el token del padron y el secreto de
# las sesiones.
#
#   cp .env.example .env
#   docker compose up --build
#
# Antes hay que tener levantado el Sistema de Registracion (el padron), que es
# el que crea la red de docker a la que se cuelga este front.

# --- Padron -------------------------------------------------------------
# URL del Sistema de Registracion
# (https://github.com/DennisMejia21/SistemaRegistracion).
#
# Es el nombre del servicio DENTRO de la red de docker, no localhost:
# `localhost` adentro del contenedor es el contenedor mismo. Solo se cambia si
# el padron corre en otro lado.
PADRON_URL=http://mock-service:8000

# Nombre de la red que levanta el compose del padron. Sale de
# `docker network ls`; es <carpeta-del-repo>_default.
RED_PADRON=sistemaregistracion_default

# Token de ESTA aplicacion contra el padron, va en `Authorization: Bearer`.
# Es el mismo valor que el API_TOKEN del .env del padron.
#
# Identifica al proyecto entero, no a la persona que entra: con el se lee el
# padron completo. NUNCA lo prefijes con NEXT_PUBLIC_ ni lo uses desde un
# componente cliente.
PADRON_TOKEN=token-de-desarrollo

# --- Sesiones -----------------------------------------------------------
# Secreto con el que se firma la cookie de sesion (HMAC-SHA256). Minimo 32
# caracteres. Cambiarlo cierra todas las sesiones abiertas.
#
#   docker run --rm node:20-alpine node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESION_SECRETO=

# --- Puertos ------------------------------------------------------------
# El de la maquina; adentro del contenedor siempre es el 3000.
PUERTO_FRONT=3001

# Interfaz donde se publica. 127.0.0.1 = solo esta maquina.
BIND_HOST=127.0.0.1

# --- Opcional -----------------------------------------------------------
# Proyectos que ofrece el formulario de alta, si el padron todavia no expone
# GET /proyectos. Por defecto usa la semilla de su database/init.sql.
# PROYECTOS="1:Carpooling,2:Alquiler de Quintas,3:Sistema de Reservas"
