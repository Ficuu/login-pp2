# Copia este archivo a `.env` y cambia los valores. El `.env` NO se sube al
# repositorio: es el único lugar donde viven las contraseñas y los tokens.
#
#   cp .env.example .env
#   docker compose up -d --build
#
# Sin `.env` el `up` corta con un error de variable faltante: es a propósito,
# para que nadie levante esto con las contraseñas del ejemplo.

# --- Base de datos ------------------------------------------------------
DB_NAME=registracion
DB_USER=registracion_user

# Contraseña de DB_USER. La usan mysql y la API: es la misma de los dos lados.
DB_PASSWORD=cambiame

# Contraseña de root de mysql, para hacer un dump si hace falta.
MYSQL_ROOT_PASSWORD=cambiame-tambien

# --- Tokens ---------------------------------------------------------------
# Token del login central, la única aplicación que ve el padrón entero (por
# ejemplo, para ofrecer "elegí tu proyecto"). Los fronts de cada proyecto NO
# usan este: cada uno tiene el suyo, dado de alta con POST /aplicaciones.
#
# Uno nuevo:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
API_TOKEN=token-de-desarrollo

# Token de la cátedra: emite resets de contraseña (POST /password/reset) y da
# de alta aplicaciones (POST /aplicaciones). TIENE que ser distinto de
# API_TOKEN: si coincidieran, cualquier front podría usarlo para lo mismo. El
# servicio se niega a arrancar si son iguales.
ADMIN_TOKEN=admin-de-desarrollo

# --- Vencimientos ---------------------------------------------------------
# Minutos que vive un token de reset de contraseña.
MINUTOS_DE_RESET=30

# Segundos que vive un código de ingreso a un proyecto. Corto a propósito:
# solo tiene que sobrevivir un redirect del navegador.
SEGUNDOS_DE_CODIGO=60

# --- Puertos ----------------------------------------------------------
PUERTO_API=8000
PUERTO_MYSQL=3307

# 127.0.0.1 = solo esta máquina. 0.0.0.0 para exponerlo al resto de la red.
BIND_HOST=127.0.0.1
